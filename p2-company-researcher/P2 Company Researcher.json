              "description": "One plain sentence, max 20 words, saying what the company sells. Use only the text.",
              "required": true
            },
            {
              "name": "b2b_saas",
              "description": "\"yes\" if the company sells software to businesses, \"no\" if it clearly sells to consumers or does not sell software, otherwise \"unknown\".",
              "required": true
            },
            {
              "name": "b2b_saas_quote",
              "description": "A quote of 5 to 25 words copied EXACTLY, character for character, from the text, that supports the b2b_saas answer. Empty if unknown.",
              "required": true
            },
            {
              "name": "data_product",
              "description": "\"yes\" if the product shows data, analytics, dashboards or reports to its customers, or syncs data between business systems; \"no\" if clearly not; otherwise \"unknown\".",
              "required": true
            },
            {
              "name": "data_product_quote",
              "description": "A quote of 5 to 25 words copied EXACTLY, character for character, from the text, that supports the data_product answer. Empty if unknown.",
              "required": true
            }
          ]
        },
        "options": {
